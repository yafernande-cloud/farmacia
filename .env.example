# Copiar a .env (no se versiona). Sin secretos reales aquí.
APP_ENV=local
LOG_LEVEL=INFO

# PostgreSQL local (docker compose en database/). Usuario/clave solo para desarrollo local.
DATABASE_URL=postgresql+psycopg://farmacia:CAMBIAR_LOCAL@localhost:5432/farmacia
POSTGRES_PASSWORD=CAMBIAR_LOCAL

# Orígenes permitidos del frontend, separados por coma (Lovable + local)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Fases siguientes (no se usan aún; se dejan vacías a propósito):
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
# ANTHROPIC_API_KEY=

# Solo pruebas (base separada, se vacía entre pruebas). Misma clave local.
TEST_DATABASE_URL=postgresql+psycopg://farmacia:CAMBIAR_LOCAL@localhost:5432/farmacia_test
# Identidad por cabecera X-Demo-User-Id (solo local/demo). Por defecto la API de negocio está apagada.
AUTH_MODE=demo_header

# ---- Telegram (H1-B). Dejar vacío hasta crear el bot; el token JAMÁS va en el chat ni en git.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=        # 16-256 caracteres [A-Za-z0-9_-]; solo si usas webhook (no necesario con telegram-poll)
SESSION_IDLE_MINUTES=10
PENDING_ATTRIBUTION_MAX_AGE_MINUTES=15
# Fotografías: no hay proveedor de visión real. none = guardar y dejar pendiente; simulated = SOLO demo/pruebas.
VISION_PROVIDER=none

# ---- Búsqueda de cadenas E15 (Farmacias Ahumada). Apagada por defecto.
# Solo se activa con una fuente cuyo uso esté autorizado por escrito. Mientras no exista esa
# autorización, la cadena se informa `not_configured` y no se hace ninguna solicitud al sitio.
# CHAIN_SEARCH_ENABLED=ahumada
# AHUMADA_LIVE_SEARCH_ENABLED=false
# AHUMADA_LIVE_SEARCH_URL=https://<fuente-autorizada>/search
# AHUMADA_LIVE_SEARCH_TIMEOUT_SECONDS=10

# ---- Búsqueda de cadenas E15 (Salcobrand, índice público de Algolia). Apagada por defecto.
# Tiene su propio interruptor y su propia configuración: no comparte nada con Ahumada.
# Solo se activa con una fuente cuyo uso esté autorizado por escrito (D-115). La clave pública
# del sitio está restringida por Referer; guardarla aquí no cambia esa restricción ni la autoriza.
# CHAIN_SEARCH_ENABLED=salcobrand
# SALCOBRAND_LIVE_SEARCH_ENABLED=false
# SALCOBRAND_LIVE_SEARCH_URL=https://<app-id>-dsn.algolia.net/1/indexes/*/queries
# SALCOBRAND_LIVE_SEARCH_APP_ID=
# SALCOBRAND_LIVE_SEARCH_API_KEY=
# SALCOBRAND_LIVE_SEARCH_INDEX=sb_variant_production
# SALCOBRAND_LIVE_SEARCH_REFERER=https://salcobrand.cl/
# SALCOBRAND_LIVE_SEARCH_TIMEOUT_SECONDS=10
# La hora del filtro se toma de /api/v2/preferences del mismo sitio y se reutiliza unos minutos;
# no requiere una variable adicional.

# ---- Búsqueda de cadenas E15 (Cruz Verde, API pública de productos). Apagada por defecto.
# Tiene su propio interruptor y su propia configuración. La sesión es anónima y vive en memoria;
# no requiere credenciales. Los endpoints oficiales tienen valores por defecto y se pueden
# reemplazar por un espejo autorizado. `CRUZVERDE_LIVE_SEARCH_BUDGET_SECONDS` limita el tiempo de
# enriquecimiento de fichas y enlaces: al vencer se devuelven los productos ya disponibles.
# Agregue `cruz_verde` a la lista existente; no quite las cadenas que ya funcionan.
# CHAIN_SEARCH_ENABLED=ahumada,salcobrand,cruz_verde
# CRUZVERDE_LIVE_SEARCH_ENABLED=false
# CRUZVERDE_LIVE_SEARCH_BASE_URL=https://api.cruzverde.cl/product-service
# CRUZVERDE_LIVE_SEARCH_LOGIN_URL=https://api.cruzverde.cl/customer-service/login
# CRUZVERDE_LIVE_SEARCH_SITEMAP_URL=https://www.cruzverde.cl/sitemap_index.xml
# CRUZVERDE_LIVE_SEARCH_TIMEOUT_SECONDS=10
# CRUZVERDE_LIVE_SEARCH_BUDGET_SECONDS=4

# ---- Interpretación de observaciones con OpenAI (A6 Fase 3). Apagada por defecto.
# Sin OPENAI_MODEL no hay llamada: no existe un valor por defecto. Para la prueba real se usa
# gpt-5.4-mini con esfuerzo de razonamiento bajo y 2500 tokens de salida como máximo.
OBSERVATION_AI_ENABLED=false
# OPENAI_API_KEY=
# OPENAI_MODEL=
# OPENAI_REASONING_EFFORT=low
# OPENAI_MAX_OUTPUT_TOKENS=2500
